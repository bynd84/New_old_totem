#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 200    // default: 10

&mmv {
    time-to-max-speed-ms = <70>;
    acceleration-exponent = <2>;
};

&mt {
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <80>;
        require-prior-idle-ms = <0>;

        layers_selector_L {
            bindings = <&sl 7>;
            key-positions = <22 24>;
            layers = <1 0 2 4 3 5>;
        };

        layers_selector_R {
            bindings = <&sl 7>;
            key-positions = <27 29>;
            layers = <1 0 2 4 3 5>;
        };

        //qwerty macroses------------------------------------------------

        qwerty_s1 {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <36 27>;
            layers = <1>;
        };

        qwerty_s2 {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <36 28>;
            layers = <1>;
        };

        qwerty_s3 {
            bindings = <&kp LS(NUMBER_3)>;
            key-positions = <36 29>;
            layers = <1>;
        };

        qwerty_s4 {
            bindings = <&kp LS(NUMBER_4)>;
            key-positions = <36 16>;
            layers = <1>;
        };

        qwerty_s5 {
            bindings = <&kp LS(N5)>;
            key-positions = <36 17>;
            layers = <1>;
        };

        qwerty_s6 {
            bindings = <&kp LS(NUMBER_6)>;
            key-positions = <36 18>;
            layers = <1>;
        };

        qwerty_s7 {
            bindings = <&kp LS(N7)>;
            key-positions = <36 5>;
            layers = <1>;
        };

        qwerty_s8 {
            bindings = <&kp LS(NUMBER_8)>;
            key-positions = <36 6>;
            layers = <1>;
        };

        qwerty_s9 {
            bindings = <&kp LS(NUMBER_9)>;
            key-positions = <36 7>;
            layers = <1>;
        };

        qwerty_s0 {
            bindings = <&kp LS(NUMBER_0)>;
            key-positions = <36 8>;
            layers = <1>;
        };

        qwerty_sm {
            bindings = <&kp LS(MINUS)>;
            key-positions = <36 15>;
            layers = <1>;
        };

        qwerty_sp {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <36 26>;
            layers = <1>;
        };

        qwerty_ssl {
            bindings = <&kp BACKSLASH>;
            key-positions = <36 9>;
            layers = <1>;
        };

        qwerty_1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <22 33>;
            layers = <1>;
        };

        qwerty_2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <23 33>;
            layers = <1>;
        };

        qwerty_3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <24 33>;
            layers = <1>;
        };

        qwerty_4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <11 33>;
            layers = <1>;
        };

        qwerty_5 {
            bindings = <&kp NUMBER_5>;
            key-positions = <12 33>;
            layers = <1>;
        };

        qwerty_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <33 13>;
            layers = <1>;
        };

        qwerty_7 {
            bindings = <&kp NUMBER_7>;
            key-positions = <33 1>;
            layers = <1>;
        };

        qwerty_8 {
            bindings = <&kp NUMBER_8>;
            key-positions = <33 2>;
            layers = <1>;
        };

        qwerty_9 {
            bindings = <&kp NUMBER_9>;
            key-positions = <33 3>;
            layers = <1>;
        };

        qwerty_0 {
            bindings = <&kp NUMBER_0>;
            key-positions = <33 4>;
            layers = <1>;
        };

        qwerty_minus {
            bindings = <&kp MINUS>;
            key-positions = <33 14>;
            layers = <1>;
        };

        qwerty_equ {
            bindings = <&kp EQUAL>;
            key-positions = <33 25>;
            layers = <1>;
        };

        qwerty_br_L {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 17>;
            layers = <1>;
        };

        qwerty_br_R {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 29>;
            layers = <1>;
        };

        qwerty_rus_to_wsad {
            bindings = <&mqwerty_to_wsad>;
            key-positions = <1 3>;
            layers = <1>;
        };

        //wsad macroses-----------------------------------

        wsad_5 {
            bindings = <&kp N5>;
            key-positions = <1 11>;
            layers = <0>;
        };

        wsad_6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <12 2>;
            layers = <0>;
        };

        wsad_7 {
            bindings = <&kp N7>;
            key-positions = <3 13>;
            layers = <0>;
        };

        wsad_8 {
            bindings = <&kp N8>;
            key-positions = <4 14>;
            layers = <0>;
        };

        wsad_9 {
            bindings = <&kp N9>;
            key-positions = <1 2>;
            layers = <0>;
        };

        wsad_0 {
            bindings = <&kp N0>;
            key-positions = <3 2>;
            layers = <0>;
        };

        wsad_z {
            bindings = <&kp Z>;
            key-positions = <22 11>;
            layers = <0>;
        };

        wsad_x {
            bindings = <&kp X>;
            key-positions = <23 12>;
            layers = <0>;
        };

        wsad_c {
            bindings = <&kp C>;
            key-positions = <24 13>;
            layers = <0>;
        };

        wsad_v {
            bindings = <&kp V>;
            key-positions = <14 25>;
            layers = <0>;
        };

        wsad_t {
            bindings = <&kp T>;
            key-positions = <22 23>;
            layers = <0>;
        };

        wsad_g {
            bindings = <&kp G>;
            key-positions = <23 24>;
            layers = <0>;
        };

        wsad_b {
            bindings = <&kp B>;
            key-positions = <24 25>;
            layers = <0>;
        };

        wsad_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <33 11 1>;
            layers = <0>;
        };

        wsad_min {
            bindings = <&kp MINUS>;
            key-positions = <12 2 33>;
            layers = <0>;
        };

        wsad_equ {
            bindings = <&kp EQUAL>;
            key-positions = <3 13 33>;
            layers = <0>;
        };

        wsad_grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        wsad_y {
            bindings = <&kp Y>;
            key-positions = <4 33>;
            layers = <0>;
        };

        wsad_u {
            bindings = <&kp U>;
            key-positions = <3 33>;
            layers = <0>;
        };

        wsad_i {
            bindings = <&kp I>;
            key-positions = <2 33>;
            layers = <0>;
        };

        wsad_o {
            bindings = <&kp O>;
            key-positions = <1 33>;
            layers = <0>;
        };

        wsad_p {
            bindings = <&kp P>;
            key-positions = <0 33>;
            layers = <0>;
        };

        wsad_h {
            bindings = <&kp H>;
            key-positions = <14 33>;
            layers = <0>;
        };

        wsad_j {
            bindings = <&kp J>;
            key-positions = <13 33>;
            layers = <0>;
        };

        wsad_k {
            bindings = <&kp K>;
            key-positions = <12 33>;
            layers = <0>;
        };

        wsad_l_key {
            bindings = <&kp L>;
            key-positions = <11 33>;
            layers = <0>;
        };

        wsad_n {
            bindings = <&kp N>;
            key-positions = <25 33>;
            layers = <0>;
        };

        wsad_m {
            bindings = <&kp M>;
            key-positions = <24 33>;
            layers = <0>;
        };

        wsad_comma {
            bindings = <&kp COMMA>;
            key-positions = <23 33>;
            layers = <0>;
        };

        wsad_period {
            bindings = <&kp PERIOD>;
            key-positions = <22 33>;
            layers = <0>;
        };

        wsad_sbr_l {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <33 11 22>;
            layers = <0>;
        };

        wsad_sbr_r {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 12 23>;
            layers = <0>;
        };

        wsad_sk {
            bindings = <&kp SEMI>;
            key-positions = <13 24 33>;
            layers = <0>;
        };

        wsad_slash {
            bindings = <&kp SLASH>;
            key-positions = <14 25 33>;
            layers = <0>;
        };

        wsad_bslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <14 4 33>;
            layers = <0>;
        };

        wsad_to_rus_qwerty {
            bindings = <&mwsad_to_qwerty>;
            key-positions = <1 3>;
            layers = <0>;
        };

        //nump macroses------------------------------------------------

        numpL_div {
            bindings = <&kp KP_DIVIDE>;
            key-positions = <1 11>;
            layers = <4>;
        };

        numpL_mult {
            bindings = <&kp KP_MULTIPLY>;
            key-positions = <2 12>;
            layers = <4>;
        };

        numpL_minus {
            bindings = <&kp KP_SUBTRACT>;
            key-positions = <3 13>;
            layers = <4>;
        };

        numpL_plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <13 24>;
            layers = <4>;
        };

        numpL_nlock {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <0 1>;
            layers = <4>;
        };

        numpL_ent {
            bindings = <&kp KP_ENTER>;
            key-positions = <23 12>;
            layers = <4>;
        };

        numpR_div {
            bindings = <&kp KP_DIVIDE>;
            key-positions = <8 18>;
            layers = <4>;
        };

        numpR_mult {
            bindings = <&kp KP_MULTIPLY>;
            key-positions = <7 17>;
            layers = <4>;
        };

        numpR_minus {
            bindings = <&kp KP_SUBTRACT>;
            key-positions = <6 16>;
            layers = <4>;
        };

        numpR_plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <16 27>;
            layers = <4>;
        };

        numpR_nlock {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <9 8>;
            layers = <4>;
        };

        numpR_ent {
            bindings = <&kp KP_ENTER>;
            key-positions = <28 17>;
            layers = <4>;
        };

        nav_ins {
            bindings = <&kp INS>;
            key-positions = <14 25>;
            layers = <2>;
        };

        qwerty_esc {
            bindings = <&kp ESC>;
            key-positions = <27 16>;
            layers = <1>;
        };

        //other macroses------------------------------------------------
    };

    behaviors {
        wasd_nums: wasd_nums {
            compatible = "zmk,behavior-hold-tap";
            label = "WASD_NUMS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };

        hl_mod: hl_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HL_MOD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };

        layer_stlayer: layer_stlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_STLAYER";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };

        kp_stlayer: kp_stlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_STLAYER";
            bindings = <&kp>, <&sl>;

            #binding-cells = <2>;
            quick-tap-ms = <0>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <0>;
        };
    };

    macros {
        mwsad_to_qwerty: mwsad_to_qwerty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_SHIFT) &to 1>;
            label = "MWSAD_TO_QWERTY";
        };

        mqwerty_to_wsad: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_SHIFT) &to 0>;
            label = "MQWERTY_TO_WSAD";
        };

        m_ljmp_up: m_ljmp_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <83>;
            wait-ms = <83>; // Пауза между шагами при удержании кнопки
            bindings =
                <&macro_press>,
                <&mmv MOVE_Y(-13300)>,
                <&macro_release>,
                <&mmv MOVE_Y(-13300)>;
        };

        m_ljmp_down: m_ljmp_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <83>;
            wait-ms = <83>; // Пауза между шагами при удержании кнопки
            bindings =
                <&macro_press>,
                <&mmv MOVE_Y(13300)>,
                <&macro_release>,
                <&mmv MOVE_Y(13300)>;
        };

        m_ljmp_right: m_ljmp_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <83>;
            wait-ms = <83>; // Пауза между шагами при удержании кнопки
            bindings =
                <&macro_press>,
                <&mmv MOVE_X(23700)>,
                <&macro_release>,
                <&mmv MOVE_X(23700)>;
        };

        m_ljmp_left: m_ljmp_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <83>;
            wait-ms = <83>; // Пауза между шагами при удержании кнопки
            bindings =
                <&macro_press>,
                <&mmv MOVE_X(-23700)>,
                <&macro_release>,
                <&mmv MOVE_X(-23700)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        wsad {
            bindings = <
           &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4       &kp N0     &kp N7  &kp N8  &kp N9  &kp BSLH
           &kp LALT   &kp A   &kp W   &kp D   &kp F        &kp MINUS  &kp N4  &kp N5  &kp N6  &kp RALT
&kp LSHFT  &kp LCTRL  &kp Q   &kp S   &kp E   &kp R        &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp RCTRL  &kp RSHFT
                              &mo 3   &mo 2   &kp SPACE    &none      &none   &none
            >;
        };

        qwerty {
            bindings = <
                    &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P
                    &kp A  &kp S  &kp D  &kp F  &kp G        &kp H      &kp J      &kp K      &kp L    &kp SEMI
&mt LEFT_ALT GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp APOS
                                  &mo 3  &mo 2  &kp LSHFT    &kp SPACE  &kp LCTRL  &kp BSPC
            >;
        };

        Navigation {
            bindings = <
           &kp TAB        &kp ESCAPE      &kp BSPC      &kp ENTER        &kp DEL          &kp DEL    &kp ESCAPE      &kp BACKSPACE   &kp ENTER        &kp TAB
           &kp RIGHT_ALT  &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp PG_UP        &kp PG_UP  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp RALT
&kp LSHFT  &kp RCTRL      &kp HOME        &kp DOWN      &kp END          &kp PAGE_DOWN    &kp PG_DN  &kp HOME        &kp DOWN_ARROW  &kp END          &kp RCTRL  &kp RSHFT
                                          &mo 4         &mo 3            &mo 5            &mo 5      &mo 3           &mo 4
            >;
        };

        Function {
            bindings = <
          &kp LGUI           &kp F7  &kp F8  &kp F9  &kp F10    &kp F10  &kp F7  &kp F8  &kp F9  &kp LGUI
          &kp C_VOLUME_UP    &kp F4  &kp F5  &kp F6  &kp F11    &kp F11  &kp F4  &kp F5  &kp F6  &kp C_VOLUME_UP
&kp RGUI  &kp C_VOLUME_DOWN  &kp F1  &kp F2  &kp F3  &kp F12    &kp F12  &kp F1  &kp F2  &kp F3  &kp C_VOLUME_DOWN  &kp RGUI
                                     &none   &none   &none      &none    &none   &none
            >;
        };

        Numpad {
            bindings = <
          &kp PRINTSCREEN  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_N0     &kp KP_N0   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PRINTSCREEN
          &kp SCROLLLOCK   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DOT    &kp KP_DOT  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp SCROLLLOCK
&kp CAPS  &kp PAUSE_BREAK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp TAB       &kp TAB     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PAUSE_BREAK  &kp CLCK
                                            &none            &none            &none         &none       &none            &none
            >;
        };

        Mouse {
            bindings = <
           &none  &m_ljmp_left       &m_ljmp_up         &m_ljmp_right     &none             &none           &m_ljmp_left       &m_ljmp_up         &m_ljmp_right     &none
           &none  &mmv MOVE_X(-500)  &mmv MOVE_Y(-500)  &mmv MOVE_X(500)  &msc SCRL_UP      &msc SCRL_UP    &mmv MOVE_X(-500)  &mmv MOVE_Y(-500)  &mmv MOVE_X(500)  &none
&mkp LCLK  &none  &mkp RCLK          &mmv MOVE_Y(500)   &mkp MCLK         &msc SCRL_DOWN    &msc SCRL_DOWN  &mkp MCLK          &mmv MOVE_Y(500)   &mkp RCLK         &none  &mkp LCLK
                                     &mo 6              &m_ljmp_down      &mkp LCLK         &mkp LCLK       &m_ljmp_down       &mo 6
            >;
        };

        Mouse2 {
            bindings = <
           &none  &m_ljmp_left      &m_ljmp_up        &m_ljmp_right    &none             &none           &m_ljmp_left      &m_ljmp_up        &m_ljmp_right    &none
           &none  &mmv MOVE_X(-50)  &mmv MOVE_Y(-50)  &mmv MOVE_X(50)  &msc SCRL_UP      &msc SCRL_UP    &mmv MOVE_X(-50)  &mmv MOVE_Y(-50)  &mmv MOVE_X(50)  &none
&mkp LCLK  &none  &mkp RCLK         &mmv MOVE_Y(50)   &mkp MCLK        &msc SCRL_DOWN    &msc SCRL_DOWN  &mkp MCLK         &mmv MOVE_Y(50)   &mkp RCLK        &none  &mkp LCLK
                                    &mkp MCLK         &m_ljmp_down     &mkp LCLK         &mkp LCLK       &m_ljmp_down      &mkp MCLK
            >;
        };

        layers {
            bindings = <
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &to 0  &to 1  &to 2  &none    &none  &to 2  &to 1  &to 0  &none
&bt BT_CLR_ALL  &none  &to 3  &to 4  &to 5  &none    &none  &to 5  &to 4  &to 3  &none  &bt BT_CLR_ALL
                              &none  &none  &none    &none  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
